APP_ENV=development
APP_PORT=8080
# Loopback binding is intentional: this POC has no application login.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing-local-only
POSTGRES_DB=billing
DATABASE_URL=postgresql+psycopg://billing:billing-local-only@postgres:5432/billing

# Stable application identity; do not change when renaming your cloud.
OPENSTACK_CLOUD_ID=00000000-0000-0000-0000-000000000001
OPENSTACK_CLOUD_NAME=OpenStack-Test
OS_AUTH_URL=
OS_USERNAME=
OS_PASSWORD=
OS_PROJECT_NAME=
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne
OS_INTERFACE=internal
# Optional application credential mode, takes precedence over password mode.
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
# Optional PEM CA path inside container. TLS verification is always enabled.
OS_CACERT=
# 2.47 includes embedded flavor dimensions; lower to 2.1 for older Nova.
OS_COMPUTE_API_VERSION=2.47
OS_API_TIMEOUT_SECONDS=30

SYNC_INTERVAL_SECONDS=300
SYNC_ENABLED=true
MISSING_SCAN_THRESHOLD=3
BILLING_POLICY_PATH=config/billing.yaml
RETAIN_RAW_PAYLOAD=false

# Phase 2. This takes precedence over the legacy MISSING_SCAN_THRESHOLD if set.
RESOURCE_MISSING_CONFIRMATION_COUNT=3
BILLING_TIMEZONE=Asia/Ho_Chi_Minh
METERING_POLICY_PATH=config/metering.yaml
METERING_CALCULATION_VERSION=meter-v1
METERING_ENABLED=true

# Phase 3: no prices are created automatically. Configure defaults through pricing assignments.
RATING_ENABLED=true
RATING_CALCULATION_VERSION=rating-v1
# Optional bearer token for financially sensitive admin routes (keep private).
PRICING_ADMIN_TOKEN=

# Phase 4. Empty tokens disable billing mutations; keep configured values private.
BILLING_ADMIN_TOKEN=
BILLING_OPERATOR_TOKEN=
ALLOW_PROVISIONAL_IN_DRAFT=true
ALLOW_PROVISIONAL_IN_FINAL=false

# Internal CPU / RAM / SSD test rates. Apply explicitly with pricing seed-internal.
BILLING_CURRENCY=VND
PRICE_CPU_PER_VCPU_HOUR=10000
PRICE_RAM_PER_GIB_HOUR=11000
PRICE_SSD_PER_GIB_HOUR=500
